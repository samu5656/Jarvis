{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@jarvis/llm": ["packages/llm/dist/index"],
      "@jarvis/core": ["packages/core/dist/index"],
      "@jarvis/tools": ["packages/tools/dist/index"],
      "@jarvis/tasks": ["packages/tasks/dist/index"],
      "@jarvis/memory": ["packages/memory/dist/index"],
      "@jarvis/voice": ["packages/voice/dist/index"],
      "@jarvis/automation": ["packages/automation/dist/index"],
      "@jarvis/proactive": ["packages/proactive/dist/index"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
